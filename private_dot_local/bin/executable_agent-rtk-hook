#!/usr/bin/env python3
import json
import re
import subprocess
import sys

ALLOWED_PREFIXES = {
    "rtk", "git", "cargo", "npm", "npx", "chezmoi",
    "ast-grep", "repomix", "ls", "cat", "head", "tail",
    "which", "pwd", "zoxide", "grep", "rg", "find",
    "file", "stat", "echo", "printf", "true", "false",
}

def is_command_allowed(command_line: str) -> bool:
    parts = re.split(r"\s*(?:&&|\|\||[;|])\s*", command_line)
    for part in parts:
        part = part.strip()
        if not part:
            continue
        tokens = part.split()
        idx = 0
        while idx < len(tokens) and "=" in tokens[idx] and not tokens[idx].startswith("-"):
            idx += 1
        if idx >= len(tokens):
            continue
        base_cmd = tokens[idx]
        base_name = base_cmd.split("/")[-1]
        if base_name not in ALLOWED_PREFIXES:
            return False
    return True

def main():
    try:
        raw_input = sys.stdin.read()
        if not raw_input.strip():
            print(json.dumps({"decision": "allow"}))
            return
        data = json.loads(raw_input)
    except Exception:
        print(json.dumps({"decision": "allow"}))
        return

    tool_call = data.get("toolCall", {})
    args = tool_call.get("args", {})
    cmd = args.get("CommandLine", "")

    if not cmd:
        print(json.dumps({"decision": "allow"}))
        return

    rewritten = None
    try:
        res = subprocess.run(
            ["rtk", "rewrite", cmd],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if res.returncode == 0 and res.stdout.strip():
            rewritten = res.stdout.strip()
    except Exception:
        pass

    target_cmd = rewritten if rewritten else cmd
    output = {}

    if is_command_allowed(cmd) or is_command_allowed(target_cmd):
        output["decision"] = "allow"
    else:
        output["decision"] = "ask"

    if rewritten and rewritten != cmd:
        output["overwrite"] = {"CommandLine": rewritten}

    print(json.dumps(output))

if __name__ == "__main__":
    main()
