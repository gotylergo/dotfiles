{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "models": {
        "qwen2.5-coder-7b-instruct": {
          "name": "Qwen 2.5 Coder"
        },
        "llama-3.2-3b-instruct": {
          "name": "Llama 3.2 3B"
        },
        "meta-llama-3.1-8b-instruct": {
          "name": "Llama 3.1"
        }
      }
    }
  },
  "model": "lmstudio/qwen2.5-coder-7b-instruct",
  "small_model": "lmstudio/llama-3.2-3b-instruct",
  "permission": {
    "read": "allow",
    "edit": "allow"
  },
  "mcp": {
  {{- $first := true -}}
  {{- range $name, $config := .mcpServers }}
    {{- if not $first }},{{ end }}{{ $first = false }}
    "{{ $name }}": {
      "type": "local",
      "disabled": true,
      "command": [ "{{ $config.executable }}"
      {{- range $arg := $config.args }}, "{{ $arg }}"{{ end }} ],
      "environment": {
      {{- $firstEnv := true -}}
      {{- range $k, $v := $config.env }}
        {{- if not $firstEnv }},{{ end }}{{ $firstEnv = false }}
        "{{ $k }}": {{ if eq $v "__BW_HORTUSFOX__" }}"{{ (bitwarden "item" "HortusFox_API_Token").login.password }}"{{ else if eq $v "__BW_GOOGLE__" }}"{{ (bitwarden "item" "Opencode_Google_Token").login.password }}"{{ else }}"{{ $v }}"{{ end }}
      {{- end }}
      }
    }
  {{- end }}
  }
}
