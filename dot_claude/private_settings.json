{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-notify 'Claude Code' 'Waiting for your input' attention high"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-notify 'Claude Code' 'Task completed' complete default"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/tyler/.claude/statusline-command.sh"
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "permissionMode": "acceptEdits",
  "permissions": {
    "allow": [
      "FileEdit",
      "FileWrite",
      "FileRead",
      "GlobTool",
      "GrepTool",
      "Bash(git *)",
      "Bash(cargo *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(rtk *)",
      "Bash(chezmoi *)",
      "Bash(ast-grep *)",
      "Bash(repomix *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(zoxide *)"
    ]
  },
  "advisorModel": "opus"
}
